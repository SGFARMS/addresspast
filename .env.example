# ── SkyHigh BaaS (leave empty to run on the built-in fake demo data) ──────
# Written automatically by baas Actions → Droplet ops → connect-tenant-site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_TENANT_KEY=
# Tenant-scoped service key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (optional locally; "Ask in plain English" falls back to rules) ─
ANTHROPIC_API_KEY=

# ── Rate limiting (optional locally; falls back to in-memory) ─────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Pre-launch preview: visit /preview?key=<this> to bypass the waitlist ──
PREVIEW_SECRET=

# ── Owner review area at /admin (closed until this is set; "admin" works in local dev) ──
ADMIN_PASSWORD=

# ── Vercel Cron auth (Vercel sets this header automatically) ──────────────
CRON_SECRET=

# ── Later phases ──────────────────────────────────────────────────────────
# RESEND_API_KEY=          # Phase 2: dispute emails
# STRIPE_SECRET_KEY=       # Phase 3
# STRIPE_WEBHOOK_SECRET=   # Phase 3
# SENTRY_DSN=              # error monitoring
